;; Alpha CI exclusions for SingleStore driver integration tests.
;; See modules/drivers/singlestore/RELEASING.md.
;; Upload tests are excluded via :mb/upload-tests tag in CI.
;; Prefer :excluded-vars over whole namespaces when only a few tests fail.
{:excluded-namespaces
 [;; EE workspaces isolation (GRANT/CREATE USER, no mysql system DB, workspace never ready)
  metabase-enterprise.workspaces.api-test
  metabase-enterprise.workspaces.execute-test
  metabase-enterprise.workspaces.isolation-test
  ;; Impersonation uses GRANT to auto-create users; SingleStore rejects that
  metabase-enterprise.impersonation.driver-test]

 :excluded-vars
 [;; Sync metadata
  "metabase.driver-test/describe-fields-returns-default-expr-test"
  "metabase.driver-test/describe-fields-returns-is-generated-test"
  ;; Timestamptz / timezone (session TZ unsupported on SingleStore)
  "metabase.query-processor.filter-test/filter-on-specific-date-timestamptz-test"
  ;; Nested query + month-bucket join on subqueries (#18502, #18512)
  "metabase.query-processor.explicit-joins-test/join-against-same-table-as-source-query-source-table-test"
  "metabase.query-processor.explicit-joins-test/joining-nested-queries-with-same-aggregation-test"
  ;; Nested queries (4 failing vars in namespace)
  "metabase.query-processor.nested-queries-test/basic-test"
  "metabase.query-processor.nested-queries-test/nested-query-with-joins-test"
  "metabase.query-processor.nested-queries-test/two-of-the-same-aggregations-test"
  "metabase.query-processor.nested-queries-test/space-names-question-test"
  ;; Array type / json_array UDF not available
  "metabase.query-processor.nested-array-test/nested-array-query-test"
  "metabase.query-processor.middleware.cache-test/array-query-can-be-cached-test"
  ;; MBQL / native parameters
  "metabase.query-processor.middleware.parameters.mbql-test/operations-e2e-test-2"
  "metabase.query-processor.parameters-test/better-error-when-parameter-mismatch"
  ;; EE workspaces REST (requires workspace infra)
  "metabase.warehouses-rest.api-test/workspace-permission-endpoint-test"
  ;; Subquery ORDER BY not preserved (rows swapped)
  "metabase.query-processor.expressions-test/nested-expressions-with-existing-names-test"
  ;; Depends on model persistence
  "metabase-enterprise.sandbox.query-processor.middleware.sandboxing-test/persistence-disabled-when-sandboxed-test"
  ;; Jetty test server URI is null in this suite (public-sharing HTTP)
  "metabase.public-sharing-rest.api-test/make-sure-it-also-works-with-the-forwarded-url"
  ;; No ORDER BY; SingleStore does not return rows in insert/id order
  "metabase-enterprise.database-routing.e2e-test/db-routing-e2e-test"]}
